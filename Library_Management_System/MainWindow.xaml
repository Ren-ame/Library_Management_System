<Window x:Class="Library_Management_System.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Library_Management_System"
        xmlns:views="clr-namespace:Library_Management_System.Views"
        mc:Ignorable="d"
        Title="도서관리 시스템" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    
    <Grid>
        <TabControl>
            <TabItem Header="도서관리">
                <views:BooksView/>
            </TabItem>
            <TabItem Header="회원관리">
                <views:MembersView/>
            </TabItem>
            <TabItem Header="대출/반납">
                <views:LoansView/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
